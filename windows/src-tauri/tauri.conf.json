{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacHub",
  "mainBinaryName": "MacHub",
  "version": "0.1.3",
  "identifier": "com.machub.windows",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run prepare-hook && npm run dev",
    "beforeBuildCommand": "npm run prepare-hook && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MacHub",
        "width": 400,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "MacHub contributors",
    "copyright": "GNU GPLv3 — dựa trên HyperMac © 2026 Nguyễn Khắc Đại",
    "shortDescription": "MacHub cho Windows",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/machub-agent-hook"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
